{
  "name": "chatuit",
  "version": "0.0.1",
  "private": true,
  "config": {
    "dev_server_port": 3000
  },
  "engines": {
    "node": ">=22.15"
  },
  "scripts": {
    "dev-server": "node --use-system-ca node_modules/webpack-cli/bin/cli.js serve --mode development",
    "build": "webpack --mode production",
    "build:dev": "webpack --mode development",
    "typecheck": "tsc --noEmit -p .",
    "lint": "office-addin-lint check",
    "lint:fix": "office-addin-lint fix",
    "prettier": "office-addin-lint prettier",
    "test:fixtures": "webpack --config fixtures/webpack.config.js && node node_modules/.cache/chatuit-fixtures/run.js",
    "validate": "office-addin-manifest validate manifests/office.xml && office-addin-manifest validate manifests/outlook.xml",
    "start:word": "office-addin-debugging start manifests/office.xml desktop --app word",
    "start:excel": "office-addin-debugging start manifests/office.xml desktop --app excel",
    "start:powerpoint": "office-addin-debugging start manifests/office.xml desktop --app powerpoint",
    "start:outlook": "office-addin-debugging start manifests/outlook.xml desktop --app outlook",
    "stop": "office-addin-debugging stop manifests/office.xml && office-addin-debugging stop manifests/outlook.xml"
  },
  "dependencies": {
    "@azure/msal-browser": "^3.17.0",
    "@fluentui/react-components": "^9.74.9",
    "exceljs": "^4.4.0",
    "fflate": "^0.8.3",
    "jszip": "^3.10.2",
    "marked": "^18.0.14",
    "openai": "^7.23.0",
    "pdfjs-dist": "^4.10.38",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@babel/core": "^7.24.0",
    "@babel/preset-react": "^7.29.7",
    "@babel/preset-typescript": "^7.23.3",
    "@eslint/js": "^10.0.1",
    "@types/office-js": "^1.0.377",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "babel-loader": "^9.1.3",
    "copy-webpack-plugin": "^14.0.0",
    "eslint-plugin-office-addins": "^5.0.1",
    "html-webpack-plugin": "^5.6.0",
    "office-addin-debugging": "^7.0.1",
    "office-addin-dev-certs": "^3.0.1",
    "office-addin-lint": "^4.0.1",
    "office-addin-manifest": "^3.0.1",
    "office-addin-prettier-config": "^3.0.1",
    "typescript": "^5.4.2",
    "webpack": "^5.90.3",
    "webpack-cli": "^5.1.4",
    "webpack-dev-server": "^6.0.0"
  },
  "browserslist": [
    "last 2 versions"
  ],
  "overrides": {
    "@azure/msal-node": "^7.1.1",
    "adm-zip": "^0.6.1",
    "archiver-utils": {
      "glob": "^13.0.6"
    },
    "eslint": "^10.0.0",
    "exceljs": {
      "archiver": "^7.0.1",
      "unzipper": "^0.12.5",
      "uuid": "^11.1.1"
    }
  }
}
